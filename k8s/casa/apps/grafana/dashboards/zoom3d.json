    {
      "id": 29,
      "type": "timeseries",
      "title": "Fan-out: sent vs received",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "description": "What 6d reduces: today every move is relayed to everyone, so sent grows with people \u00d7 movers.",
      "gridPos": {
        "x": 16,
        "y": 12,
        "w": 8,
        "h": 7
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(rate(zoom3d_messages_sent_total[1m]))",
          "legendFormat": "sent / s"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(rate(zoom3d_messages_total[1m]))",
          "legendFormat": "received / s"
        },
        {
          "refId": "C",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(rate(zoom3d_messages_sent_total[1m])) / clamp_min(sum(zoom3d_peers{state=\"connected\"}), 1)",
          "legendFormat": "sent / s per connected person"
        }
      ],
